<!DOCTYPE html>
<html lang="th">
<head>
<%- include('partials/head', { title: title }) %>
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="page">

    <main class="content" id="main-content">

      <header class="page-head">
        <h1 class="page-head__title">สภาพโรงเรือน</h1>
        <p class="page-head__lead">อัปเดตล่าสุด <time id="reading-last-updated"<% if (latest) { %> datetime="<%= latest.createdAt %>" title="<%= labels.fullTime(latest.createdAt) %>"<% } %>><%= latest ? labels.relativeTime(latest.createdAt, nowMs) : 'ยังไม่มีข้อมูล' %></time></p>
      </header>

      <%
        var stale = !latest || !latest.online;
        var staleSeconds = latest ? Math.max(0, Math.round((nowMs - new Date(latest.createdAt).getTime()) / 1000)) : 0;
      %>
      <!-- ── สรุปสถานะ ── -->
      <%- include('partials/status-summary', { stale: stale, staleSeconds: staleSeconds }) %>

      <!-- ── ค่าเซนเซอร์ล่าสุด 3 ค่า + ต่ำสุด/สูงสุด 24 ชม. ── -->
      <section class="stats-grid" aria-label="ค่าที่วัดได้ล่าสุด">
        <%- include('partials/stat-card', {
          metricKey: 'co2',
          label: 'CO₂',
          value: latest ? latest.co2 : null,
          unit: 'ppm',
          status: latest ? latest.status.co2 : 'unknown',
          thresholds: thresholds,
          stats: stats,
          stale: stale,
          icon: 'i-co2'
        }) %>
        <%- include('partials/stat-card', {
          metricKey: 'temperature',
          label: 'อุณหภูมิ',
          value: latest ? latest.temperature : null,
          unit: '°C',
          status: latest ? latest.status.temperature : 'unknown',
          thresholds: thresholds,
          stats: stats,
          stale: stale,
          icon: 'i-temp'
        }) %>
        <%- include('partials/stat-card', {
          metricKey: 'humidity',
          label: 'ความชื้น',
          value: latest ? latest.humidity : null,
          unit: '%',
          status: latest ? latest.status.humidity : 'unknown',
          thresholds: thresholds,
          stats: stats,
          stale: stale,
          icon: 'i-drop'
        }) %>
      </section>

      <!-- ── อุปกรณ์และการทำงานอัตโนมัติ (หน้าเดียวเข้าใจครบ) ── -->
      <section class="panel" aria-labelledby="actuator-heading">
        <div class="panel__header">
          <div>
            <h2 class="panel__title" id="actuator-heading">อุปกรณ์และการทำงานอัตโนมัติ</h2>
            <p class="panel__subtitle">กล่องควบคุมสั่งงานปลั๊กเครื่องพ่นน้ำเองอัตโนมัติตามความชื้น</p>
          </div>
        </div>
        <div class="actuator-grid" id="actuator-grid">
          <% plugs.forEach(function (plug) { %>
            <%- include('partials/actuator-card', { plug: plug }) %>
          <% }); %>
          <%- include('partials/health-matrix', { latest: latest }) %>
        </div>
        <dl class="rules-strip" aria-label="เกณฑ์การทำงานอัตโนมัติ">
          <div class="rules-strip__item">
            <dt>คุมเครื่องพ่นน้ำ</dt>
            <dd>เปิดเมื่อความชื้น <strong>&lt; <%= logic.mister.onHumidityBelow %>%</strong> · ปิดเมื่อ <strong>&ge; <%= logic.mister.offHumidityAtOrAbove %>%</strong></dd>
          </div>
          <div class="rules-strip__item">
            <dt>เวลาขั้นต่ำ</dt>
            <dd>เปิดอย่างน้อย <strong><%= logic.mister.minOnMinutes %> นาที</strong> · ปิดอย่างน้อย <strong><%= logic.mister.minOffMinutes %> นาที</strong></dd>
          </div>
          <div class="rules-strip__item">
            <dt>รอบวัด &amp; นิรภัย</dt>
            <dd>วัดทุก <strong><%= logic.readEverySeconds %> วิ</strong> (เฉลี่ย <%= logic.smoothingReadings %> ค่า) · ขาดค่า <%= logic.sensorFailMinutes %> นาทีปิดปั๊ม</dd>
          </div>
          <div class="rules-strip__item">
            <dt>CO₂ และอุณหภูมิ</dt>
            <dd>วัดและแจ้งเตือนเท่านั้น (CO₂ เตือนเมื่อ <strong>&ge; <%= logic.co2DangerAtOrAbove %> ppm</strong>)</dd>
          </div>
        </dl>
      </section>

      <!-- ── Chart Panel ── -->
      <section class="panel" aria-labelledby="chart-heading">
        <div class="panel__header">
          <div>
            <h2 class="panel__title" id="chart-heading">ย้อนหลัง 24 ชั่วโมง</h2>
            <p class="panel__subtitle">เฉลี่ยทุก <%= Math.round(chartBucketSeconds / 60) %> นาที</p>
          </div>
          <div class="legend" role="list" aria-label="คำอธิบายเส้นกราฟ">
            <div class="legend__item" role="listitem">
              <span class="legend__dot legend__dot--co2" aria-hidden="true"></span>
              <span>CO₂</span>
            </div>
            <div class="legend__item" role="listitem">
              <span class="legend__dot legend__dot--temperature" aria-hidden="true"></span>
              <span>อุณหภูมิ</span>
            </div>
            <div class="legend__item" role="listitem">
              <span class="legend__dot legend__dot--humidity" aria-hidden="true"></span>
              <span>ความชื้น</span>
            </div>
          </div>
        </div>
        <div class="chart-wrap">
          <canvas id="history-chart" role="img" aria-label="กราฟค่าที่วัดได้ย้อนหลัง 24 ชั่วโมง" aria-describedby="chart-summary"></canvas>
          <p class="sr-only" id="chart-summary">
            <% if (stats && stats.minCo2 !== null && stats.minCo2 !== undefined) { %>
              ช่วง 24 ชั่วโมงที่ผ่านมา CO₂ อยู่ระหว่าง <%= stats.minCo2 %> ถึง <%= stats.maxCo2 %> ppm, อุณหภูมิ <%= stats.minTemperature %> ถึง <%= stats.maxTemperature %> °C, ความชื้น <%= stats.minHumidity %> ถึง <%= stats.maxHumidity %> %
            <% } else { %>ยังไม่มีข้อมูลย้อนหลัง<% } %>
          </p>
        </div>
      </section>

      <!-- ── ประวัติล่าสุด (พับได้) ── -->
      <details class="panel research" id="research-details">
        <summary class="research__summary">
          <span>
            <span class="panel__title">ประวัติล่าสุด</span>
            <span class="panel__subtitle">ค่าที่วัดและคำสั่ง <%= tableRows %> รายการล่าสุด</span>
          </span>
          <svg class="icon research__chevron" aria-hidden="true"><use href="#i-chevron"/></svg>
        </summary>

        <div class="research__body">
          <h3 class="research__heading" id="table-heading">ค่าที่วัดได้</h3>
        <div class="table-wrap">
          <table class="history-table">
            <thead>
              <tr>
                <th scope="col">เวลา</th>
                <th scope="col">CO₂ (ppm)</th>
                <th scope="col">อุณหภูมิ (°C)</th>
                <th scope="col">ความชื้น (%)</th>
              </tr>
            </thead>
            <tbody id="history-table-body">
              <% if (recent.length === 0) { %>
                <tr><td colspan="4" class="empty-row">ยังไม่มีข้อมูล</td></tr>
              <% } %>
              <% recent.forEach(function(r) { %>
                <tr>
                  <td title="<%= labels.fullTime(r.createdAt) %>"><%= labels.shortTime(r.createdAt, nowMs) %></td>
                  <td class="status-<%= r.status.co2 %>"><%= labels.value('co2', r.co2) %></td>
                  <td class="status-<%= r.status.temperature %>"><%= labels.value('temperature', r.temperature) %></td>
                  <td class="status-<%= r.status.humidity %>"><%= labels.value('humidity', r.humidity) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

          <h3 class="research__heading" id="decision-heading">คำสั่งเครื่องพ่นน้ำ</h3>
          <%- include('partials/decision-log', { decisions: decisions }) %>
        </div>
      </details>

    </main>

  </div>
  <%- include('partials/footer') %>

  <!-- Initial SSR data for client hydration -->
  <template id="initial-data"><%- JSON.stringify({
    latest,
    chartSeries,
    chartBucketSeconds,
    stats,
    thresholds,
    deviceId: latest ? latest.deviceId : null,
    plugs,
    decisions,
    serverNow: nowMs,
    plugStaleSeconds,
    deviceOfflineSeconds,
    tableRows,
    co2DangerAt
  }).replace(/</g, '\\u003c') %></template>

  <!-- Chart.js (เสิร์ฟจาก node_modules ในเครื่องเอง ไม่พึ่ง CDN) -->
  <script src="/vendor/chart.js/chart.umd.js" defer></script>

  <!-- Dashboard client -->
  <script src="/js/labels.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/plug-view.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/dashboard.client.js?v=<%= assetVersion %>" defer></script>
</body>
</html>

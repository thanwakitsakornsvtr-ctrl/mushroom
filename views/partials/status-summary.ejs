<%
  // status-summary — id="status-summary" + data-role="title"/"text" ที่ dashboard.client.js ต้องการ
  // ประโยคมาจาก labels.summary ตัวเดียวกับที่ browser ใช้ตอนอัปเดตสด (กันข้อความเปลี่ยนวูบหลังโหลดหน้า)
  var _byDevice = {};
  plugs.forEach(function (p) { _byDevice[p.device] = p; });
  var sum = labels.summary({
    hasData: !!latest,
    stale: stale,
    staleSeconds: staleSeconds,
    values: latest || {},
    status: latest ? latest.status : {},
    co2DangerAt: co2DangerAt,
    fan: plugView.brief(_byDevice.fan, nowMs, plugStaleSeconds),
    mister: plugView.brief(_byDevice.mister, nowMs, plugStaleSeconds)
  });
%>
<%# role="status" ประกาศเฉพาะตอนข้อความเปลี่ยน (JS ตั้งข้อความเมื่อต่างจากเดิมเท่านั้น); ไอคอนสลับด้วย CSS ตาม class summary--ok/warn/alert %>
<div id="status-summary" class="summary summary--<%= sum.tone %>" role="status">
  <div class="summary__icon" aria-hidden="true">
    <svg class="icon summary__icon-ok"><use href="#i-ok"/></svg>
    <svg class="icon summary__icon-warn"><use href="#i-warn"/></svg>
    <svg class="icon summary__icon-alert"><use href="#i-alert"/></svg>
  </div>
  <div>
    <p class="summary__title" data-role="title"><%= sum.title %></p>
    <p class="summary__text"  data-role="text"><%= sum.text %></p>
  </div>
</div>

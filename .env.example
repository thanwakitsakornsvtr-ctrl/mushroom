# Server
PORT=4100
NODE_ENV=production

# Security - ESP32 device must send this key in the "X-API-Key" header
DEVICE_API_KEY=change-me-to-a-long-random-string

# Public site (landing page / SEO) — the real domain, no trailing slash
SITE_URL=https://example.com

# Farm contact info shown on the landing page and footer.
# Any value left empty is simply hidden from the page.
FARM_ADDRESS=
FARM_PHONE=
FARM_LINE=
FARM_FACEBOOK_URL=
FARM_MAP_URL=

# CORS - comma separated list of allowed origins, or * for any
CORS_ORIGIN=*

# Database
# Railway: attach a volume and mount it to /app/data, then use /app/data/mushroom.db
DB_PATH=./data/mushroom.db

# Railway automatically sets this when a volume is attached.
# If DB_PATH is not set, the app will use $RAILWAY_VOLUME_MOUNT_PATH/mushroom.db.
# RAILWAY_VOLUME_MOUNT_PATH=/app/data

# Data retention (days) - older readings are pruned automatically
DATA_RETENTION_DAYS=30

# Considered "offline" if no reading received within this many seconds
DEVICE_OFFLINE_SECONDS=60

# Plug status is treated as unknown if the ESP32 hasn't reported it within this many seconds
PLUG_STALE_SECONDS=90

# Logging
LOG_LEVEL=info

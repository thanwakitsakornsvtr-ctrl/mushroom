# Dependencies
node_modules/

# Local configuration; commit only the documented template.
.env
.env.*
!.env.example

# Runtime data; keep empty directories available after cloning.
/data/*
!/data/.gitkeep
/logs/*
!/logs/.gitkeep
/backups/

# Test output and caches (test source stays in Git).
coverage/
.nyc_output/
test-results/
playwright-report/
.cache/

# Process manager and package-manager logs
.pm2/
*.log
npm-debug.log*

# Local tooling and credentials
/.agents/
/.codex/
/.aws/
.idea/

# OS metadata and temporary editor files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.bak
*.orig
*.rej

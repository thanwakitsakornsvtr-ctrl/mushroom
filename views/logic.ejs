<!DOCTYPE html>
<html lang="th">
<head>
<%- include('partials/head', { title: title }) %>
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="page">

    <main class="content" id="main-content">
      <header class="page-head">
        <h1 class="page-head__title">ระบบดูแลโรงเรือนอย่างไร</h1>
        <p class="page-head__lead">อ่านเกณฑ์ที่ใช้สั่งเปิด–ปิดพัดลมและเครื่องพ่นเพิ่มความชื้น ค่าด้านล่างเป็นเกณฑ์ที่บันทึกไว้ในเว็บไซต์</p>
      </header>

      <!-- ── ขั้นตอนการทำงาน ── -->
      <section class="panel" aria-labelledby="flow-heading">
        <div class="panel__header">
          <div>
            <h2 class="panel__title" id="flow-heading">ระบบทำงานอย่างไร</h2>
            <p class="panel__subtitle">กล่องควบคุมอ่านค่าทุก <%= logic.readEverySeconds %> วินาที</p>
          </div>
        </div>
        <ol class="logic-flow" aria-label="ขั้นตอน">
          <li class="logic-step">
            <div class="logic-step__num">1</div>
            <p class="logic-step__title">วัดค่า</p>
            <p class="logic-step__text">เครื่องวัดตรวจคาร์บอนไดออกไซด์ อุณหภูมิ และความชื้นในอากาศ แล้วนำ <%= logic.smoothingReadings %> ค่าล่าสุดมาเฉลี่ย</p>
          </li>
          <li class="logic-step">
            <div class="logic-step__num">2</div>
            <p class="logic-step__title">ตรวจค่าที่วัดได้</p>
            <p class="logic-step__text">ตรวจว่าแต่ละค่าอยู่ในช่วงที่กำหนดหรือไม่ หากไม่ได้รับค่าจากเครื่องวัดนาน <%= logic.sensorFailMinutes %> นาที ระบบจะหยุดสั่งงาน</p>
          </li>
          <li class="logic-step">
            <div class="logic-step__num">3</div>
            <p class="logic-step__title">สั่งอุปกรณ์</p>
            <p class="logic-step__text">ส่งคำสั่งเปิด/ปิดผ่าน Wi-Fi ไปยังปลั๊กอัจฉริยะ ตรวจสอบผลทุก <%= logic.plugCheckSeconds %> วินาที</p>
          </li>
        </ol>
        <p class="logic-note">เว็บไซต์ใช้ดูข้อมูล ส่วนกล่องควบคุมสั่งเปิด–ปิดอุปกรณ์อัตโนมัติ</p>
      </section>

      <!-- ── กฎการเปิด/ปิดอุปกรณ์ ── -->
      <div class="rule-grid">

        <!-- พัดลม -->
        <section class="panel rule-card" aria-labelledby="fan-heading">
          <div class="panel__header">
            <div>
              <h2 class="panel__title" id="fan-heading">
                <svg class="icon icon--title" aria-hidden="true"><use href="#i-fan"/></svg>
                พัดลม
              </h2>
              <p class="panel__subtitle">ระบายอากาศเพื่อลดคาร์บอนไดออกไซด์และความร้อน</p>
            </div>
          </div>
          <dl class="rule-list">
            <div class="rule-row">
              <dt class="status-badge status-badge--normal">เปิดเมื่อ</dt>
              <dd>อุณหภูมิสูงกว่า <strong><%= logic.fan.onTempAbove %> °C</strong><br>หรือคาร์บอนไดออกไซด์สูงกว่า <strong><%= logic.fan.onCo2Above %> ppm</strong></dd>
            </div>
            <div class="rule-row">
              <dt class="status-badge status-badge--unknown">ปิดเมื่อ</dt>
              <dd>อุณหภูมิ <strong><%= logic.fan.offTempAtOrBelow %> °C</strong> หรือต่ำกว่า<br>และคาร์บอนไดออกไซด์ <strong><%= logic.fan.offCo2AtOrBelow %> ppm</strong> หรือต่ำกว่า</dd>
            </div>
            <div class="rule-row">
              <dt class="rule-row__label">เวลาก่อนเปลี่ยนสถานะ</dt>
              <dd>เปิดอย่างน้อย <strong><%= logic.fan.minOnMinutes %> นาที</strong> · ปิดอย่างน้อย <strong><%= logic.fan.minOffMinutes %> นาที</strong></dd>
            </div>
          </dl>
        </section>

        <!-- เครื่องพ่นไอน้ำ -->
        <section class="panel rule-card" aria-labelledby="mister-heading">
          <div class="panel__header">
            <div>
              <h2 class="panel__title" id="mister-heading">
                <svg class="icon icon--title" aria-hidden="true"><use href="#i-mister"/></svg>
                เครื่องพ่นเพิ่มความชื้น
              </h2>
              <p class="panel__subtitle">รักษาความชื้น</p>
            </div>
          </div>
          <dl class="rule-list">
            <div class="rule-row">
              <dt class="status-badge status-badge--normal">เปิดเมื่อ</dt>
              <dd>ความชื้นในอากาศต่ำกว่า <strong><%= logic.mister.onHumidityBelow %> %</strong></dd>
            </div>
            <div class="rule-row">
              <dt class="status-badge status-badge--unknown">ปิดเมื่อ</dt>
              <dd>ความชื้นในอากาศตั้งแต่ <strong><%= logic.mister.offHumidityAtOrAbove %> %</strong> ขึ้นไป</dd>
            </div>
            <div class="rule-row">
              <dt class="rule-row__label">เวลาก่อนเปลี่ยนสถานะ</dt>
              <dd>เปิดอย่างน้อย <strong><%= logic.mister.minOnMinutes %> นาที</strong> · ปิดอย่างน้อย <strong><%= logic.mister.minOffMinutes %> นาที</strong></dd>
            </div>
            <div class="rule-row">
              <dt class="rule-row__label">รอหลังพัดลม</dt>
              <dd>รอ <strong><%= logic.mister.waitAfterFanMinutes %> นาที</strong> หลังพัดลมปิด ก่อนเปิดเครื่องพ่นเพิ่มความชื้น</dd>
            </div>
          </dl>
        </section>

      </div>

      <!-- ── เกณฑ์อันตราย CO₂ ── -->
      <section class="panel panel--spaced" aria-labelledby="danger-heading">
        <div class="panel__header">
          <h2 class="panel__title" id="danger-heading">ระดับแจ้งเตือนคาร์บอนไดออกไซด์</h2>
        </div>
        <p class="logic-warning">
          เมื่อคาร์บอนไดออกไซด์ตั้งแต่ <strong><%= logic.co2DangerAtOrAbove %> ppm</strong> ขึ้นไป หน้าสภาพโรงเรือนจะแสดงคำเตือนเมื่อได้รับข้อมูล ควรตรวจการระบายอากาศ
        </p>
        <ul class="logic-points">
          <li>ช่วงที่กำหนดในเว็บไซต์: ไม่เกิน <%= thresholds.co2.normalMax %> ppm</li>
          <li>ppm คือหน่วยวัดปริมาณก๊าซ</li>
          <li>ระบบใช้เกณฑ์เปิดพัดลมเมื่อคาร์บอนไดออกไซด์สูงกว่า <%= logic.fan.onCo2Above %> ppm โดยมีระยะเวลารอก่อนเปิด–ปิด</li>
        </ul>
      </section>

      <details class="panel">
        <summary>รายละเอียดอุปกรณ์สำหรับผู้ดูแล</summary>
        <p class="logic-note">กล่องควบคุม ESP32 · เครื่องวัดคาร์บอนไดออกไซด์ SCD40 · เครื่องวัดอุณหภูมิและความชื้น SHT30/SHT40</p>
        <p class="logic-note">เกณฑ์ในหน้านี้บันทึกไว้ฝั่งเว็บไซต์ ผู้ดูแลต้องปรับให้ตรงเมื่อเปลี่ยนการตั้งค่าที่กล่องควบคุม</p>
      </details>

    </main>

  </div>
  <%- include('partials/footer') %>
</body>
</html>

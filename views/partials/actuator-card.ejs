<%
  // actuator-card partial — data-role ต้องตรงกับที่ dashboard.client.js ใช้:
  //   dot="dot", state="state", updated="updated", error="error"
  var view = plugView.describe(plug, nowMs, plugStaleSeconds);
  var deviceLabel = plugView.LABEL[plug.device] || plug.device;
  var iconId = plug.device === 'fan' ? 'i-fan' : 'i-mister';
%>
<article class="actuator-card" id="plug-<%= plug.device %>" data-device="<%= plug.device %>">
  <div class="actuator-card__header">
    <span class="actuator-card__icon" aria-hidden="true"><svg class="icon"><use href="#<%= iconId %>"/></svg></span>
    <span class="status-dot status-dot--<%= view.online ? 'online' : 'offline' %>" data-role="dot" aria-hidden="true"></span>
    <p class="actuator-card__label"><%= deviceLabel %></p>
    <span class="status-badge status-badge--<%= view.badge %>" data-role="state"><%= view.text %></span>
  </div>
  <p class="actuator-card__meta" data-role="updated"><%= view.meta %></p>
  <p class="actuator-card__error" data-role="error"<% if (!view.error) { %> hidden<% } %>><%= view.error || '' %></p>
</article>
